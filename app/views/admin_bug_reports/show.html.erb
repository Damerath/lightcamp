<div class="space-y-6">
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="text-sm font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Bugreport #<%= @bug_report.id %></p>
      <h2 class="mt-1 text-2xl font-bold"><%= @bug_report.title %></h2>
    </div>
    <div class="flex flex-wrap justify-end gap-3">
      <%= button_to "Löschen", admin_bug_report_path(@bug_report), method: :delete, data: { turbo_confirm: "Diesen Bugreport wirklich löschen?" }, class: "inline-flex rounded-lg border border-red-300 px-4 py-2 text-sm font-medium text-red-700 hover:bg-red-50 dark:border-red-800 dark:text-red-300 dark:hover:bg-red-950/40" %>
      <%= link_to "Zurück zu den Bugs", admin_bug_reports_path, class: "inline-flex rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-200 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-700" %>
    </div>
  </div>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]">
    <div class="space-y-6">
      <section class="rounded-xl bg-white p-5 shadow dark:bg-slate-800">
        <h3 class="font-semibold">Beschreibung</h3>
        <p class="mt-3 whitespace-pre-wrap text-slate-700 dark:text-slate-300"><%= @bug_report.description %></p>
      </section>
      <% if @bug_report.screenshot.attached? %>
        <section class="rounded-xl bg-white p-5 shadow dark:bg-slate-800">
          <h3 class="font-semibold">Screenshot</h3>
          <%= image_tag @bug_report.screenshot, class: "mt-3 max-h-[38rem] rounded-lg border border-slate-200 dark:border-slate-700", alt: "Screenshot zum Bugreport ##{@bug_report.id}" %>
        </section>
      <% end %>
    </div>

    <div class="space-y-6">
      <section class="rounded-xl bg-white p-5 shadow dark:bg-slate-800">
        <h3 class="font-semibold">Kontext</h3>
        <dl class="mt-3 space-y-3 text-sm">
          <div><dt class="text-slate-500 dark:text-slate-400">Gemeldet von</dt><dd><%= @bug_report.user.display_name %></dd></div>
          <div><dt class="text-slate-500 dark:text-slate-400">Zeitpunkt</dt><dd><%= l(@bug_report.created_at, format: "%d.%m.%Y %H:%M") %></dd></div>
          <div><dt class="text-slate-500 dark:text-slate-400">Kategorie</dt><dd><%= @bug_report.category_label %></dd></div>
          <div><dt class="text-slate-500 dark:text-slate-400">Seite</dt><dd class="break-all"><%= @bug_report.page_url.presence || "Nicht verfügbar" %></dd></div>
          <div><dt class="text-slate-500 dark:text-slate-400">Browser</dt><dd class="break-words"><%= @bug_report.browser_details.presence || "Nicht verfügbar" %></dd></div>
          <div><dt class="text-slate-500 dark:text-slate-400">Ansicht</dt><dd><%= @bug_report.viewport.presence || "Nicht verfügbar" %></dd></div>
        </dl>
      </section>

      <%= form_with model: @bug_report, url: admin_bug_report_path(@bug_report), method: :patch, class: "rounded-xl bg-white p-5 shadow dark:bg-slate-800" do |form| %>
        <h3 class="font-semibold">Bearbeitung</h3>
        <div class="mt-4">
          <%= form.label :status, "Status", class: "mb-1 block text-sm font-medium" %>
          <%= form.select :status, [["Neu", "reported"], ["In Bearbeitung", "in_progress"], ["Gelöst", "resolved"], ["Geschlossen", "closed"]], {}, class: "w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-600 dark:bg-slate-900" %>
        </div>
        <div class="mt-4">
          <%= form.label :admin_notes, "Interne Notizen", class: "mb-1 block text-sm font-medium" %>
          <%= form.text_area :admin_notes, rows: 5, class: "w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm dark:border-slate-600 dark:bg-slate-900" %>
        </div>
        <%= form.submit "Speichern", class: "mt-4 inline-flex rounded-lg bg-red-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-red-700" %>
      <% end %>
    </div>
  </div>
</div>
