<% page_path = lambda do |recipe_id: nil, recipe_modal: nil|
     options = { section: "recipe_book" }
     options[:recipe_id] = recipe_id if recipe_id.present?
     options[:recipe_modal] = recipe_modal if recipe_modal.present?
     admin ? admin_camp_team_page_path(@camp, @camp_team, options) : camp_team_page_path(@camp, @camp_team, options)
   end %>
<% collection_path = admin ? admin_camp_kitchen_recipes_path(@camp, @camp_team) : camp_kitchen_recipes_path(@camp, @camp_team) %>
<% recipe_resource_path = lambda { |recipe| admin ? admin_camp_kitchen_recipe_path(@camp, @camp_team, recipe) : camp_kitchen_recipe_path(@camp, @camp_team, recipe) } %>
<% ingredient_collection_path = lambda { |recipe| admin ? admin_camp_kitchen_recipe_ingredients_path(@camp, @camp_team, recipe) : camp_kitchen_recipe_ingredients_path(@camp, @camp_team, recipe) } %>
<% ingredient_resource_path = lambda { |recipe, ingredient, **options| admin ? admin_camp_kitchen_recipe_ingredient_path(@camp, @camp_team, recipe, ingredient, options) : camp_kitchen_recipe_ingredient_path(@camp, @camp_team, recipe, ingredient, options) } %>

<% if @recipe.present? %>
  <div class="space-y-6" data-controller="recipe-scaler" data-recipe-scaler-base-servings-value="<%= @recipe.base_servings %>">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <p class="text-sm font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400"><%= @recipe.category || "Mahlzeit" %></p>
        <h3 class="text-2xl font-bold"><%= @recipe.title %></h3>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Aufwand: <%= @recipe.effort_level %> von 5</p>
      </div>
      <div class="flex flex-col items-end gap-3">
        <%= link_to "Zurück zum Rezeptbuch", page_path.call, class: "inline-flex rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 dark:border-slate-600 dark:text-slate-300" %>
        <% if @can_manage_recipes %>
          <div class="flex flex-wrap justify-end gap-3">
            <button type="submit" form="recipe-details-form" class="rounded-lg bg-red-600 px-4 py-2 text-sm font-medium text-white">Rezept speichern</button>
            <%= button_to "Rezept löschen", recipe_resource_path.call(@recipe), method: :delete, params: { team_view: "1" }, form: { class: "inline-flex" }, data: { turbo_confirm: "Rezept inklusive aller Zutaten wirklich löschen?" }, class: "rounded-lg border border-red-300 bg-red-50 px-4 py-2 text-sm font-medium text-red-700 shadow-sm hover:bg-red-100 dark:border-red-800 dark:bg-red-950 dark:text-red-300 dark:hover:bg-red-900" %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="rounded-2xl bg-white p-5 shadow dark:bg-slate-800">
      <label class="text-sm font-medium" for="recipe-servings">Berechnen für</label>
      <div class="mt-2 flex items-center gap-3">
        <input id="recipe-servings" type="number" min="1" value="<%= @recipe.base_servings %>" data-recipe-scaler-target="servings" data-action="input->recipe-scaler#scale" class="w-28 rounded-lg border border-slate-300 bg-white px-3 py-2 dark:border-slate-600 dark:bg-slate-900">
        <span class="text-sm text-slate-500">Personen</span>
      </div>
      <ul class="mt-5 space-y-2">
        <% @ingredients.each do |ingredient| %>
          <li class="flex gap-2"><strong data-recipe-scaler-target="amount" data-amount="<%= ingredient.amount %>"><%= ingredient.amount %></strong><span><%= ingredient.unit %> <%= ingredient.name %></span></li>
        <% end %>
      </ul>
    </div>

    <div class="rounded-2xl bg-white p-5 shadow dark:bg-slate-800">
      <h4 class="font-semibold">Zubereitung</h4>
      <div class="mt-3 leading-7"><%= render_recipe_instructions(@recipe) %></div>
    </div>

    <% if @can_manage_recipes %>
      <div class="grid gap-4 xl:grid-cols-3">
        <div class="rounded-2xl bg-white p-5 shadow dark:bg-slate-800">
          <h4 class="font-semibold">Rezeptdaten</h4>
          <%= form_with model: @recipe, url: recipe_resource_path.call(@recipe), method: :patch, id: "recipe-details-form", class: "mt-4 space-y-3" do |f| %>
            <%= hidden_field_tag :team_view, "1" %>
            <%= f.text_field :title, class: "w-full rounded-lg border border-slate-300 bg-white px-3 py-2 dark:border-slate-600 dark:bg-slate-900" %>
            <%= f.select :category, KitchenRecipe::MEAL_CATEGORIES, { include_blank: "Mahlzeit auswählen" }, class: "w-full rounded-lg border border-slate-300 bg-white px-3 py-2 dark:border-slate-600 dark:bg-slate-900" %>
            <%= f.select :effort_level, (1..5).map { |value| ["#{value} - #{value == 1 ? 'leicht und schnell' : value == 5 ? 'sehr aufwändig' : 'Aufwand'}", value] }, {}, class: "w-full rounded-lg border border-slate-300 bg-white px-3 py-2 dark:border-slate-600 dark:bg-slate-900" %>
            <%= f.number_field :base_servings, min: 1, class: "w-full rounded-lg border border-slate-300 bg-white px-3 py-2 dark:border-slate-600 dark:bg-slate-900" %>
          <% end %>
        </div>

        <%= turbo_frame_tag "recipe_ingredients", class: "block h-full xl:col-span-2" do %>
        <div class="h-full rounded-2xl bg-white p-5 shadow dark:bg-slate-800 xl:col-span-2">
          <h4 class="font-semibold">Zutaten</h4>
          <div class="mt-3 grid gap-2 text-xs font-medium" style="grid-template-columns:60px 60px minmax(0, 1fr) 32px 32px;">
            <span>Menge</span>
            <span>Einheit</span>
            <span>Zutat</span>
          </div>
          <div class="mt-3 space-y-3">
            <% @ingredients.each do |ingredient| %>
              <%= form_with model: ingredient, url: ingredient_resource_path.call(@recipe, ingredient), method: :patch, style: "display: grid grid-cols-5", class: "items-center gap-2" do |f| %>
                <%= hidden_field_tag :team_view, "1" %>
                <%= f.number_field :amount, step: 1, aria: { label: "Menge für #{ingredient.name}" }, style: "width: clamp(30px, 16vw, 60px);", class: "min-w-0 rounded border border-slate-300 px-2 py-1.5 dark:border-slate-600 dark:bg-slate-900" %>
                <%= f.text_field :unit, aria: { label: "Einheit für #{ingredient.name}" }, style: "width: clamp(30px, 16vw, 60px);", class: "rounded border border-slate-300 px-2 py-1.5 dark:border-slate-600 dark:bg-slate-900" %>
                <%= f.text_field :name, aria: { label: "Name der Zutat" }, style: "width: clamp(80px, 22vw, 320px);", class: "min-w-0 rounded border border-slate-300 px-2 py-1.5 dark:border-slate-600 dark:bg-slate-900" %>
                <button type="submit" aria-label="Zutat speichern" title="Zutat speichern" class="inline-flex h-8 w-8 items-center justify-center rounded-md bg-blue-600 text-white shadow-sm hover:bg-blue-700"><i data-lucide="check" class="h-4 w-4"></i></button>
                <%= link_to ingredient_resource_path.call(@recipe, ingredient, team_view: "1"), data: { turbo_method: :delete, turbo_confirm: "Zutat wirklich löschen?" }, aria: { label: "Zutat löschen" }, title: "Zutat löschen", class: "inline-flex h-8 w-8 items-center justify-center rounded-md border border-red-300 bg-red-50 text-red-700 shadow-sm hover:bg-red-100 dark:border-red-800 dark:bg-red-950 dark:text-red-300 dark:hover:bg-red-900" do %><i data-lucide="x" class="h-4 w-4"></i><% end %>
              <% end %>
            <% end %>
          </div>
          <div class="mt-3 space-y-3">
            <%= form_with model: KitchenRecipeIngredient.new, url: ingredient_collection_path.call(@recipe), style: "display: grid grid-cols-5", class: "items-center gap-2" do |f| %>
              <%= hidden_field_tag :team_view, "1" %>
              <%= f.number_field :amount, step: 1, aria: { label: "Menge" }, style: "width: clamp(30px, 16vw, 60px);", class: "min-w-0 rounded border border-slate-300 px-2 py-1.5 dark:border-slate-600 dark:bg-slate-900" %>
              <%= f.text_field :unit, aria: { label: "Einheit" }, style: "width: clamp(30px, 16vw, 60px);", class: "min-w-0 rounded border border-slate-300 px-2 py-1.5 dark:border-slate-600 dark:bg-slate-900" %>
              <%= f.text_field :name, aria: { label: "Zutat" }, style: "width: clamp(80px, 22vw, 320px);", class: "min-w-0 rounded border border-slate-300 px-2 py-1.5 dark:border-slate-600 dark:bg-slate-900" %>
              <button type="submit" aria-label="Zutat hinzufügen" title="Zutat hinzufügen" class="inline-flex h-8 w-8 items-center justify-center rounded-md bg-blue-600 text-white shadow-sm hover:bg-blue-700"><i data-lucide="check" class="h-4 w-4"></i></button>
            <% end %>
          </div>
        </div>
        <% end %>
      </div>

      <div class="rounded-2xl bg-white p-5 shadow dark:bg-slate-800" data-controller="recipe-token-inserter">
        <h4 class="font-semibold">Zubereitung mit automatischen Mengen</h4>
        <p class="mt-1 text-sm text-slate-500">Wähle eine Zutat aus, um sie an der Cursorposition einzufügen.</p>
        <%= form_with model: @recipe, url: recipe_resource_path.call(@recipe), method: :patch, class: "mt-4 space-y-3" do |f| %>
          <%= hidden_field_tag :team_view, "1" %>
          <%= f.hidden_field :instructions, data: { recipe_token_inserter_target: "input" } %>
          <div contenteditable="true" role="textbox" aria-multiline="true" aria-label="Zubereitung" data-recipe-token-inserter-target="editor" data-action="input->recipe-token-inserter#sync" class="min-h-40 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm leading-7 outline-none focus:border-blue-400 dark:border-slate-600 dark:bg-slate-900"></div>
          <div class="flex flex-wrap gap-2">
            <% @ingredients.each do |ingredient| %>
              <button type="button" data-action="click->recipe-token-inserter#insert" data-token="[[ingredient:<%= ingredient.id %>:full]]" data-preview="<%= ingredient.amount %> <%= ingredient.unit %> <%= ingredient.name %>" class="rounded border px-2 py-1 text-sm"><%= ingredient.name %></button>
            <% end %>
          </div>
          <%= f.submit "Zubereitung speichern", class: "rounded-lg bg-red-600 px-4 py-2 text-sm font-medium text-white" %>
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="space-y-5">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div><h3 class="text-2xl font-bold">Rezeptbuch</h3><p class="mt-1 text-slate-600 dark:text-slate-400">Zentrale Rezepte für alle Camps.</p></div>
      <% if @can_manage_recipes %><%= link_to "Neues Rezept anlegen", page_path.call(recipe_modal: "new"), class: "inline-flex rounded-lg bg-red-600 px-4 py-2 text-sm font-medium text-white" %><% end %>
    </div>
    <% if @recipes.any? %>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <% @recipes.each do |recipe| %>
          <%= link_to page_path.call(recipe_id: recipe.id), class: "rounded-xl bg-white p-5 shadow transition hover:ring-1 hover:ring-blue-400 dark:bg-slate-800" do %>
            <p class="font-semibold"><%= recipe.title %></p><p class="mt-1 text-sm text-slate-500 dark:text-slate-400"><%= recipe.category || "Mahlzeit" %> · Aufwand <%= recipe.effort_level %>/5 · für <%= recipe.base_servings %> Personen</p>
          <% end %>
        <% end %>
      </div>
    <% else %><p class="rounded-xl bg-white p-5 text-slate-600 shadow dark:bg-slate-800 dark:text-slate-400">Es wurden noch keine Rezepte angelegt.</p><% end %>
  </div>

  <% if params[:recipe_modal] == "new" && @can_manage_recipes %>
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 px-4 backdrop-blur-sm">
      <div class="w-full max-w-lg rounded-2xl bg-white p-6 shadow-xl dark:bg-slate-800">
        <div class="flex items-start justify-between gap-4"><div><h3 class="text-xl font-bold">Neues Rezept anlegen</h3><p class="mt-1 text-sm text-slate-500">Die Zutaten und Zubereitung ergänzt du anschließend.</p></div><%= link_to "×", page_path.call, class: "text-2xl leading-none text-slate-500" %></div>
        <%= form_with model: KitchenRecipe.new(base_servings: 100, effort_level: 1), url: collection_path, class: "mt-5 space-y-4" do |f| %>
          <%= hidden_field_tag :team_view, "1" %>
          <div><%= f.label :title, "Rezeptname", class: "mb-1 block text-sm font-medium" %><%= f.text_field :title, autofocus: true, class: "w-full rounded-lg border border-slate-300 bg-white px-3 py-2 dark:border-slate-600 dark:bg-slate-900" %></div>
          <div><%= f.label :category, "Mahlzeit", class: "mb-1 block text-sm font-medium" %><%= f.select :category, KitchenRecipe::MEAL_CATEGORIES, { include_blank: "Bitte auswählen" }, class: "w-full rounded-lg border border-slate-300 bg-white px-3 py-2 dark:border-slate-600 dark:bg-slate-900" %></div>
          <div><%= f.label :base_servings, "Grundmenge für Personen", class: "mb-1 block text-sm font-medium" %><%= f.number_field :base_servings, min: 1, class: "w-full rounded-lg border border-slate-300 bg-white px-3 py-2 dark:border-slate-600 dark:bg-slate-900" %></div>
          <div><%= f.label :effort_level, "Aufwand", class: "mb-1 block text-sm font-medium" %><%= f.select :effort_level, (1..5).map { |value| ["#{value} - #{value == 1 ? 'leicht und schnell' : value == 5 ? 'sehr aufwändig' : 'mittlerer Aufwand'}", value] }, {}, class: "w-full rounded-lg border border-slate-300 bg-white px-3 py-2 dark:border-slate-600 dark:bg-slate-900" %></div>
          <div class="flex justify-end gap-3"><%= link_to "Abbrechen", page_path.call, class: "rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium" %><%= f.submit "Rezept anlegen", class: "rounded-lg bg-red-600 px-4 py-2 text-sm font-medium text-white" %></div>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
