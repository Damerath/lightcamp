<div class="space-y-6">
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="text-sm font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Kueche</p>
      <h2 class="text-2xl font-bold">Globales Rezeptbuch</h2>
      <p class="mt-1 text-slate-600 dark:text-slate-400">Rezepte werden zentral fuer alle Camps gepflegt.</p>
    </div>
    <%= link_to "Zur Teamseite", kitchen_plan_path, class: "inline-flex rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 dark:border-slate-600 dark:text-slate-300" %>
  </div>

  <% if @camp_team.kitchen_recipe_manager?(current_user) %>
    <%= form_with model: @recipe, url: recipe_index_path, class: "grid gap-3 rounded-2xl bg-white p-5 shadow sm:grid-cols-[1fr_10rem_9rem_auto] dark:bg-slate-800" do |f| %>
      <%= f.text_field :title, placeholder: "Neues Rezept", class: "rounded-lg border border-slate-300 bg-white px-3 py-2 dark:border-slate-600 dark:bg-slate-900" %>
      <%= f.text_field :category, placeholder: "Kategorie", class: "rounded-lg border border-slate-300 bg-white px-3 py-2 dark:border-slate-600 dark:bg-slate-900" %>
      <%= f.number_field :base_servings, min: 1, class: "rounded-lg border border-slate-300 bg-white px-3 py-2 dark:border-slate-600 dark:bg-slate-900" %>
      <%= f.submit "Anlegen", class: "rounded-lg bg-red-600 px-4 py-2 text-sm font-medium text-white" %>
    <% end %>
  <% end %>

  <% if @recipes.any? %>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      <% @recipes.each do |recipe| %>
        <%= link_to recipe_path(recipe), class: "rounded-xl bg-white p-5 shadow transition hover:ring-1 hover:ring-blue-400 dark:bg-slate-800" do %>
          <p class="font-semibold"><%= recipe.title %></p>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
            <%= recipe.category.presence || "Ohne Kategorie" %> · fuer <%= recipe.base_servings %> Personen
          </p>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <p class="rounded-xl bg-white p-5 text-slate-600 shadow dark:bg-slate-800 dark:text-slate-400">
      Es wurden noch keine Rezepte angelegt.
    </p>
  <% end %>
</div>
