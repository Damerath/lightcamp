<% assignments = kitchen_day_plan.recipe_assignments.select { |assignment| assignment.meal_slot == meal_slot } %>

<div class="mt-2 space-y-2">
  <% if assignments.any? %>
    <div class="flex flex-wrap gap-1.5">
      <% assignments.each do |assignment| %>
        <% recipe = assignment.kitchen_recipe %>
        <div class="inline-flex items-center gap-1 rounded-full border border-slate-200 bg-white px-2 py-1 text-xs font-medium text-slate-700 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200">
          <%= link_to recipe_book_path.call(recipe), class: "inline-flex items-center gap-1.5 hover:text-blue-600 dark:hover:text-blue-400" do %>
            <span class="h-2 w-2 rounded-full <%= recipe_effort_color_class(recipe) %>" title="Aufwand: <%= recipe.effort_level %> von 5" aria-label="Aufwand: <%= recipe.effort_level %> von 5"></span>
            <%= recipe.title %>
          <% end %>
          <% if can_manage %>
            <%= link_to assignment_destroy_path.call(kitchen_day_plan, assignment), data: { turbo_method: :delete, turbo_confirm: "Rezept aus diesem Essen entfernen?" }, aria: { label: "#{recipe.title} entfernen" }, title: "Rezept entfernen", class: "inline-flex h-4 w-4 items-center justify-center rounded text-slate-400 hover:bg-red-100 hover:text-red-600 dark:hover:bg-red-950 dark:hover:text-red-400" do %>
              <i data-lucide="x" class="h-3.5 w-3.5"></i>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if can_manage %>
    <div class="flex items-center gap-2">
      <%= select_tag "kitchen_recipe_assignment[recipe_ids][#{meal_slot}]", options_from_collection_for_select(recipes, :id, :title), include_blank: "Rezept auswählen", class: "min-w-0 flex-1 rounded-lg border border-slate-300 bg-white px-2 py-1.5 text-xs text-slate-900 outline-none focus:border-blue-400 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100" %>
      <%= button_tag "Hinzufügen", type: "submit", formaction: assignment_create_path.call(kitchen_day_plan), formmethod: :post, name: "meal_slot", value: meal_slot, class: "shrink-0 rounded-lg border border-slate-300 px-2 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-100 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-700" %>
    </div>
  <% end %>
</div>
