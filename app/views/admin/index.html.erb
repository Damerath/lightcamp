<div class="space-y-8">
  <div>
    <h2 class="text-2xl font-bold">Adminbereich</h2>
    <p class="mt-1 text-slate-600 dark:text-slate-400">
      Hier verwaltest du Benutzer und ihre Berechtigungen.
    </p>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <%= link_to users_path, class: "block rounded-lg bg-white p-5 shadow hover:ring-1 hover:ring-blue-400 dark:bg-slate-800" do %>
      <h3 class="font-semibold text-slate-900 dark:text-slate-100">Benutzerverwaltung</h3>
      <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
        Benutzer, Rollen und Berechtigungen verwalten.
      </p>
    <% end %>

    <%= link_to leadership_path, class: "block rounded-lg bg-white p-5 shadow hover:ring-1 hover:ring-blue-400 dark:bg-slate-800" do %>
      <h3 class="font-semibold text-slate-900 dark:text-slate-100">Leitung</h3>
      <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
        Zur operativen Campverwaltung wechseln.
      </p>
    <% end %>
  </div>
</div>
