<div class="space-y-3">
  <% if deliveries.any? %>
    <% deliveries.each do |delivery| %>
      <div class="relative">
        <%= link_to notification_delivery_visit_path(delivery), class: "flex items-start justify-between gap-4 rounded-lg border border-slate-200 px-4 py-3 pr-16 transition hover:ring-1 hover:ring-blue-400 dark:border-slate-700" do %>
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2">
              <p class="font-medium text-slate-900 dark:text-slate-100"><%= delivery.title %></p>
            </div>
            <p class="mt-1 text-sm text-slate-600 dark:text-slate-300"><%= delivery.body %></p>
            <div class="flex items-center justify-between gap-4">
              <p class="mt-2 text-xs text-slate-500 dark:text-slate-400"><%= l(delivery.created_at, format: "%d.%m.%Y %H:%M") %></p>
              <% if delivery.unread? %>
                <span class="rounded-full bg-amber-700 px-2 py-0.5 text-[11px] font-semibold text-amber-200">neu</span>
              <% end %>
            </div>
          </div>
        <% end %>

        <div class="absolute right-3 top-3">
          <%= button_to "×", notification_delivery_dismiss_path(delivery), method: :patch, class: "inline-flex h-8 w-8 items-center justify-center rounded-lg border border-slate-300 bg-white/90 text-slate-500 transition hover:text-slate-700 hover:border-red-700 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-300 dark:hover:text-slate-100" %>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="rounded-xl border border-dashed border-slate-300 px-4 py-5 text-sm text-slate-500 dark:border-slate-700 dark:text-slate-400">
      Für dich gibt es aktuell keine offenen Benachrichtigungen.
    </div>
  <% end %>
</div>
