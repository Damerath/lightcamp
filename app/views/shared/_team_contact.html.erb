<% contact = camp_team.team_template&.responsible_user %>
<% if contact.present? %>
  <div class="<%= local_assigns.fetch(:card, true) ? 'rounded-2xl bg-white p-5 shadow dark:bg-slate-800' : 'border-b border-slate-200 pb-5 dark:border-slate-700' %>">
    <p class="text-sm font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">Ansprechpartner</p>
    <div class="mt-1 flex items-center justify-between gap-3">
      <p class="text-lg font-semibold text-slate-900 dark:text-slate-100"><%= contact.display_name %></p>
      <% if contact.phone.present? %>
        <div class="flex items-center gap-2">
          <%= link_to team_contact_phone_href(contact.phone), aria: { label: "#{contact.display_name} anrufen" }, title: "Anrufen", class: "inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-300 text-slate-700 transition hover:bg-slate-100 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-700" do %><i data-lucide="phone" class="h-4 w-4"></i><% end %>
          <%= link_to team_contact_whatsapp_href(contact.phone), target: "_blank", rel: "noreferrer", aria: { label: "#{contact.display_name} über WhatsApp kontaktieren" }, title: "WhatsApp", class: "inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-300 text-slate-700 transition hover:bg-slate-100 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-700" do %><svg viewBox="0 0 32 32" aria-hidden="true" class="h-5 w-5" style="fill: #ffffff"><path d="M16 3a13 13 0 0 0-11.1 19.8L3 29l6.4-1.7A13 13 0 1 0 16 3Zm0 23.6a10.5 10.5 0 0 1-5.3-1.4l-.4-.2-3.8 1 1-3.7-.3-.4A10.5 10.5 0 1 1 16 26.6Zm5.8-7.9c-.3-.2-1.8-.9-2.1-1s-.5-.2-.8.2-.9 1-1.1 1.2-.4.3-.7.1a8.6 8.6 0 0 1-2.5-1.5 9.4 9.4 0 0 1-1.8-2.2c-.2-.3 0-.5.1-.7l.5-.6c.2-.2.2-.4.3-.6s0-.5 0-.7l-.9-2.1c-.2-.5-.5-.4-.7-.4h-.6c-.2 0-.6.1-.9.5s-1.2 1.2-1.2 3 .9 3.4 1 3.6a12 12 0 0 0 4.6 4.2c.6.3 1.1.5 1.5.6.6.2 1.2.2 1.7.1.5-.1 1.8-.7 2-1.4s.3-1.3.2-1.4-.2-.2-.5-.4Z"/></svg><% end %>
        </div>
      <% end %>
    </div>
    <% if contact.phone.present? %><p class="mt-1 text-sm text-slate-600 dark:text-slate-400"><%= contact.phone %></p><% end %>
  </div>
<% end %>
