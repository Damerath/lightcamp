<div class="space-y-8">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h2 class="text-2xl font-bold">Leitungs-Links</h2>
      <p class="mt-1 text-slate-600 dark:text-slate-400">Interne Links, die nur für die Leitung sichtbar sind.</p>
    </div>
    <%= link_to "Zur Leitungs-Übersicht", leadership_path, class: "inline-flex rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-200 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-700" %>
  </div>

  <div class="rounded-2xl bg-white p-6 shadow dark:bg-slate-800">
    <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Wichtige Links</h3>
    <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Diese Links stehen allen Personen mit Leitungsrolle zur Verfügung.</p>

    <%= form_with model: LeadershipLink.new, url: leadership_links_path, class: "mt-5 grid gap-4 sm:grid-cols-[1fr_1.3fr_auto]" do |f| %>
      <div>
        <%= f.label :title, "Titel", class: "mb-1 block text-sm font-medium text-slate-700 dark:text-slate-300" %>
        <%= f.text_field :title, autofocus: params[:focus_link] == "1", class: "w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-slate-900 outline-none transition focus:border-blue-400 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100" %>
      </div>
      <div>
        <%= f.label :url, "Link", class: "mb-1 block text-sm font-medium text-slate-700 dark:text-slate-300" %>
        <%= f.url_field :url, placeholder: "https://...", class: "w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-slate-900 outline-none transition focus:border-blue-400 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100" %>
      </div>
      <div class="flex items-end">
        <%= f.submit "Hinzufügen", class: "inline-flex rounded-lg bg-red-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-red-700" %>
      </div>
    <% end %>

    <div class="mt-5 space-y-3" data-controller="sortable" data-sortable-url-value="<%= reorder_leadership_links_path %>" data-action="dragover->sortable#dragOver drop->sortable#drop">
      <% @leadership_links.each do |link| %>
        <div data-sortable-target="item" data-sortable-id-value="<%= link.id %>" class="flex items-center justify-between gap-4 rounded-lg border border-slate-200 px-4 py-3 dark:border-slate-700">
          <div class="flex min-w-0 flex-1 items-center gap-3">
            <button type="button" draggable="true" data-action="dragstart->sortable#dragStart dragend->sortable#dragEnd" aria-label="<%= link.title %> verschieben" title="Zum Sortieren ziehen" class="shrink-0 cursor-grab touch-none text-slate-400 hover:text-slate-600 active:cursor-grabbing dark:hover:text-slate-200">
              <i data-lucide="grip-vertical" class="h-5 w-5"></i>
            </button>
            <div class="min-w-0 flex-1">
              <p class="truncate font-medium text-slate-900 dark:text-slate-100"><%= link.title %></p>
              <%= link_to link.url, link.url, target: "_blank", rel: "noreferrer", class: "block truncate text-sm text-blue-600 hover:underline dark:text-blue-400" %>
            </div>
          </div>
          <%= link_to "Entfernen", leadership_link_path(link), data: { turbo_method: :delete, turbo_confirm: "Link wirklich entfernen?" }, class: "shrink-0 text-sm font-medium text-red-600 hover:text-red-700 dark:text-red-400" %>
        </div>
      <% end %>

      <% if @leadership_links.empty? %>
        <p class="text-sm text-slate-500 dark:text-slate-400">Noch keine Leitungs-Links hinterlegt.</p>
      <% end %>
    </div>
  </div>
</div>
