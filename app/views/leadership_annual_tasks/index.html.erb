<div class="space-y-8">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h2 class="text-2xl font-bold">Jahresaufgaben</h2>
      <p class="mt-1 text-slate-600 dark:text-slate-400">Wiederkehrende Leitungsaufgaben mit Verantwortlichkeit, Checkliste und Erinnerungen.</p>
    </div>
    <div class="flex flex-col items-end gap-3">
      <%= link_to "Zur Leitungs-Übersicht", leadership_path, class: "inline-flex rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-200 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-700" %>
      <%= link_to "Jahresaufgabe anlegen", leadership_annual_tasks_path(modal: "new"), class: "inline-flex rounded-lg bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-700" %>
    </div>
  </div>

  <section>
    <h3 class="text-lg font-semibold">Offene Aufgaben</h3>
    <div class="mt-3 space-y-3">
      <% @open_tasks.each do |task| %>
        <div class="rounded-xl bg-white p-5 shadow dark:bg-slate-800">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
            <%= link_to leadership_annual_task_path(task), class: "min-w-0 flex-1" do %>
              <p class="truncate font-semibold text-slate-900 dark:text-slate-100"><%= task.title %></p>
              <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Verantwortlich: <%= task.responsible_user.display_name %></p>
              <% if task.comment.present? %>
                <p class="mt-2 truncate text-sm text-slate-600 dark:text-slate-300"><%= task.comment %></p>
              <% end %>
            <% end %>
            <span class="shrink-0 rounded-full bg-amber-100 px-3 py-1 text-sm font-semibold text-amber-800 dark:bg-amber-900/60 dark:text-amber-100">Stichtag: <%= task.due_date_label %></span>
          </div>
        </div>
      <% end %>
      <% if @open_tasks.empty? %>
        <p class="rounded-xl bg-white p-5 text-slate-600 shadow dark:bg-slate-800 dark:text-slate-400">Keine offenen Jahresaufgaben.</p>
      <% end %>
    </div>
  </section>

  <% if @completed_tasks.any? %>
    <section>
      <h3 class="text-lg font-semibold text-slate-500 dark:text-slate-400">Erledigte Aufgaben</h3>
      <div class="mt-3 space-y-3">
        <% @completed_tasks.each do |task| %>
          <div class="rounded-xl bg-white p-5 shadow dark:bg-slate-800">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
              <%= link_to leadership_annual_task_path(task), class: "min-w-0 flex-1" do %>
                <div class="flex items-center gap-2">
                  <p class="truncate font-semibold text-slate-500 line-through dark:text-slate-400"><%= task.title %></p>
                  <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-semibold text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300">Erledigt</span>
                </div>
                <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Verantwortlich: <%= task.responsible_user.display_name %></p>
                <% if task.comment.present? %>
                  <p class="mt-2 truncate text-sm text-slate-500 dark:text-slate-400"><%= task.comment %></p>
                <% end %>
              <% end %>
              <div class="flex shrink-0 flex-wrap items-center gap-2"><span class="rounded-full bg-amber-100 px-3 py-1 text-sm font-semibold text-amber-800 dark:bg-amber-900/60 dark:text-amber-100">Stichtag: <%= task.due_date_label %></span><%= button_to "Reaktivieren", reactivate_leadership_annual_task_path(task), method: :post, data: { turbo_confirm: "Aufgabe jetzt für einen neuen Durchlauf reaktivieren? Checkliste und Kommentar werden zurückgesetzt." }, class: "rounded-lg border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-700" %></div>
            </div>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if @inactive_tasks.any? %>
    <section>
      <h3 class="text-lg font-semibold text-slate-500 dark:text-slate-400">Inaktive Aufgaben</h3>
      <div class="mt-3 space-y-3">
        <% @inactive_tasks.each do |task| %>
          <%= link_to leadership_annual_task_path(task), class: "block rounded-xl bg-white p-5 shadow dark:bg-slate-800" do %>
            <p class="font-semibold text-slate-500 dark:text-slate-400"><%= task.title %></p>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Verantwortlich: <%= task.responsible_user.display_name %></p>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if params[:modal] == "new" %>
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 px-4 backdrop-blur-sm">
      <div class="max-h-[90vh] w-full max-w-2xl overflow-y-auto rounded-2xl bg-white p-6 shadow-xl dark:bg-slate-800">
        <div class="mb-5 flex items-start justify-between gap-4">
          <div><h3 class="text-xl font-bold">Jahresaufgabe anlegen</h3><p class="mt-1 text-sm text-slate-500">Die Aufgabe bleibt dauerhaft bestehen und wird jährlich reaktiviert.</p></div>
          <%= link_to "×", leadership_annual_tasks_path, class: "text-2xl leading-none text-slate-500" %>
        </div>
        <%= render "form", task: LeadershipAnnualTask.new(active: true, due_month: Date.current.month, due_day: Date.current.day, reactivation_month: Date.current.month, reactivation_day: Date.current.day), management_users: @management_users %>
      </div>
    </div>
  <% end %>
</div>
