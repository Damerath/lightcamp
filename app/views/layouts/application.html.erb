<!DOCTYPE html>
<html>
  <head>
    <title>Lightcamp HQ</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://unpkg.com/lucide@latest"></script>
  </head>

  <body class="bg-slate-100 text-slate-900 dark:bg-slate-900 dark:text-slate-100">
    <div
      data-controller="confirm-modal"
      class="hidden"
    >
      <div
        data-confirm-modal-target="backdrop"
        data-action="click->confirm-modal#closeFromBackdrop"
        class="fixed inset-0 z-[70] flex items-center justify-center bg-slate-950/60 px-4 opacity-0 transition duration-150"
      >
        <div
          data-confirm-modal-target="panel"
          class="w-full max-w-md rounded-2xl border border-slate-200 bg-white p-6 shadow-2xl opacity-0 translate-y-4 scale-95 transition duration-150 dark:border-slate-700 dark:bg-slate-800"
        >
          <div class="flex items-start gap-3">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-700 dark:bg-red-950/60 dark:text-red-300">
              !
            </div>
            <div class="min-w-0">
              <h3 data-confirm-modal-target="title" class="text-lg font-semibold text-slate-900 dark:text-slate-100">
                Bitte bestätigen
              </h3>
              <p data-confirm-modal-target="message" class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300"></p>
            </div>
          </div>

          <div class="mt-6 flex justify-end gap-3">
            <button
              type="button"
              data-confirm-modal-target="cancelButton"
              class="inline-flex rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-medium text-slate-700 transition hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-slate-300 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-700"
            >
              Abbrechen
            </button>
            <button
              type="button"
              data-confirm-modal-target="confirmButton"
              class="inline-flex rounded-lg bg-red-600 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-400"
            >
              Bestätigen
            </button>
          </div>
        </div>
      </div>
    </div>

    <header class="bg-white dark:bg-slate-800 shadow">
      <div class="mx-auto max-w-5xl px-6 py-4 flex items-center justify-between">
        
        <div class="flex items-center gap-3">
          <%= link_to root_path do %>
            <%= image_tag("lightcamp_logo.png", alt: "Lightcamp Logo", class: "h-9 w-auto block dark:hidden") %>
            <%= image_tag("lightcamp_logo_dark.png", alt: "Lightcamp Logo", class: "h-9 w-auto hidden dark:block") %>
          <% end %>
          <span class="text-xl font-semibold text-slate-600 dark:text-slate-300">HQ</span>
        </div>

        <% if user_signed_in? %>
          <nav class="flex items-center gap-3 text-sm font-medium md:gap-6">
            <%= link_to camps_path,
              class: "text-sm font-medium #{current_page?(camps_path) ? 'text-red-600' : 'text-slate-600 dark:text-slate-300 hover:text-blue-400'}" do %>
              <span class="md:hidden">Camps</span>
              <span class="hidden md:inline">Meine Camps</span>
            <% end %>
            <a href="#" class="hidden text-slate-700 hover:text-blue-400 md:inline">Leitung</a>
            <% if current_user.admin? %>
              <%= link_to "Admin", admin_path,
                class: "text-sm font-medium #{current_page?(admin_path) ? 'text-red-600' : 'text-slate-600 dark:text-slate-300 hover:text-blue-400'}" %>
            <% end %>
            <div class="relative" data-controller="menu">
              <button type="button" data-action="click->menu#toggle">
                <span data-menu-target="icon" class="text-slate-300 transition">
                  ☰
                </span>
              </button>

              <div data-menu-target="menu" class="hidden absolute right-0 mt-2 w-40 rounded-lg bg-white shadow dark:bg-slate-800">
                <%= link_to "Profil", profile_path, class: "block px-4 py-2 text-sm hover:bg-slate-100 dark:hover:bg-slate-700" %>

                <%= button_to "Logout", destroy_user_session_path, method: :delete,
                  class: "w-full text-left px-4 py-2 text-sm hover:bg-slate-100 dark:hover:bg-slate-700" %>
              </div>
            </div>
          </nav>
        <% end %>
      </div>
    </header>

    <main class="mx-auto max-w-5xl px-6 py-8">
      <%= yield %>
    </main>
    <% if user_signed_in? && !current_page?(root_path) %>
      <div data-controller="notifications-drawer">
        <button
          type="button"
          data-action="click->notifications-drawer#open"
          class="fixed bottom-6 right-6 z-40 inline-flex h-11 w-11 items-center justify-center rounded-xl border border-slate-300 bg-white text-slate-600 shadow-lg transition hover:ring-1 hover:ring-blue-400 md:bottom-auto md:right-6 md:top-24 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-300"
          aria-label="Benachrichtigungen öffnen"
        >
          <span class="text-lg">🔔</span>
          <% if @unread_notification_count.to_i.positive? %>
            <span class="absolute -right-1.5 -top-1.5 inline-flex min-w-[1.25rem] items-center justify-center rounded-full bg-amber-700 px-1.5 py-0.5 text-[10px] font-semibold text-amber-200">
              <%= @unread_notification_count %>
            </span>
          <% end %>
        </button>

        <div
          data-notifications-drawer-target="backdrop"
          data-action="click->notifications-drawer#closeFromBackdrop"
          class="hidden fixed inset-0 z-[65] bg-slate-950/50 opacity-0 transition duration-150"
        >
          <aside
            data-notifications-drawer-target="panel"
            class="absolute right-0 top-0 h-full w-full max-w-md translate-x-full overflow-y-auto border-l border-slate-200 bg-white p-6 shadow-2xl transition duration-150 dark:border-slate-700 dark:bg-slate-800"
          >
            <div class="flex items-start justify-between gap-4">
              <div>
                <div class="flex items-start justify-between gap-3">
                  <div>
                    <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Benachrichtigungen</h3>
                    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
                      Bleiben sichtbar, bis du sie ausblendest.
                    </p>
                  </div>
                  <% if @unread_notification_count.to_i.positive? %>
                    <span class="inline-flex rounded-full bg-amber-700 px-2.5 py-1 text-xs font-semibold text-amber-200">
                      <%= @unread_notification_count %>
                    </span>
                  <% end %>
                </div>
              </div>
              <button
                type="button"
                data-action="click->notifications-drawer#close"
                class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-300 text-slate-500 transition hover:border-red-700 hover:text-slate-700 dark:text-slate-300 dark:hover:text-slate-100"
                aria-label="Benachrichtigungen schließen"
              >
                ×
              </button>
            </div>

            <div class="mt-5">
              <%= render "shared/notification_deliveries", deliveries: @notification_deliveries %>
            </div>
          </aside>
        </div>
      </div>
    <% end %>
    <div class="fixed bottom-6 left-1/2 text-center transform -translate-x-1/2 z-50 space-y-3 w-full max-w-5xl">
      <% if notice %>
        <div
          data-controller="flash"
          class="rounded-lg bg-green-300 px-4 py-3 text-slate-900 shadow-lg transition duration-300 ease-out"
        >
          <%= notice %>
        </div>
      <% end %>

      <% if alert %>
        <div
          data-controller="flash"
          class="rounded-lg bg-red-300 px-4 py-3 text-slate-900 shadow-lg transition duration-300 ease-out"
        >
          <%= alert %>
        </div>
      <% end %>
    </div>
    <script>
      lucide.createIcons();
    </script>
  </body>
</html>
